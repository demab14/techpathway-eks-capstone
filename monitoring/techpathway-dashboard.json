          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (app) (label_replace(rate(container_cpu_usage_seconds_total{namespace=\"techpathway\", container!=\"\", container!=\"POD\"}[2m]), \"app\", \"$1\", \"pod\", \"(.*)-[a-z0-9]+-[a-z0-9]+\"))",
          "legendFormat": "{{app}}",
